{
  "name": "my-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && npm test && astro build && npm run verify:content",
    "preview": "astro preview",
    "astro": "astro",
    "raw:generate": "node scripts/generate-post-from-raw.mjs",
    "raw:dry-run": "node scripts/generate-post-from-raw.mjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check && tsc --noEmit",
    "verify:content": "node scripts/verify-content.mjs",
    "content:baseline": "node scripts/verify-content.mjs --update-baseline"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "6.3.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.17.1",
    "fuse.js": "^7.1.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-text": "^4.0.2",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-smartypants": "3.0.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
