---
import { getImage } from 'astro:assets';
import Blog from '../components/Blog';
import PageLayout from '../layouts/PageLayout.astro';
import { getRecentPostSummaries } from '../utils/posts';
import { getBlogPosts } from '../utils/content';
import { siteConfig } from '../config/site';
import avatarSrc from '../assets/avatar.png';

const posts = await getBlogPosts();
const recentPosts = getRecentPostSummaries(posts, 3);
const avatarImage = await getImage({
  src: avatarSrc,
  width: 160,
  height: 160,
  densities: [1, 2],
  format: 'webp',
  layout: 'fixed',
});
const avatar = {
  src: avatarImage.src,
  srcSet: avatarImage.srcSet.attribute,
  width: 160,
  height: 160,
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  author: {
    '@type': 'Person',
    name: siteConfig.author,
    url: siteConfig.url,
  },
};
---

<PageLayout title={siteConfig.title} description={siteConfig.description} activePath="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <link slot="head" rel="preload" as="image" href={avatar.src} type="image/webp" />
  <Blog posts={recentPosts} avatar={avatar} />
</PageLayout>
