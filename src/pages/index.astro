---
import Blog from '../components/Blog';
import PageLayout from '../layouts/PageLayout.astro';
import { getRecentPostSummaries } from '../utils/posts';
import { getBlogPosts } from '../utils/content';

const posts = await getBlogPosts();
const recentPosts = getRecentPostSummaries(posts, 3);
---

<PageLayout title="DESIGNER.BLOG" description="极简风格的个人博客" activePath="/">
  <Blog client:load posts={recentPosts} />
</PageLayout>
