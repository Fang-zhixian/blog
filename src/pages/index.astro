---
import Blog from '../components/Blog';
import PageLayout from '../layouts/PageLayout.astro';
import { getRecentPostSummaries } from '../utils/posts';
import { getBlogPosts } from '../utils/content';
import { siteConfig } from '../config/site';

const posts = await getBlogPosts();
const recentPosts = getRecentPostSummaries(posts, 3);
---

<PageLayout title={siteConfig.title} description={siteConfig.description} activePath="/">
  <Blog client:load posts={recentPosts} />
</PageLayout>
