---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../config/site';
---

<PageLayout title={`页面不存在 - ${siteConfig.name}`} description="没有找到这个页面">
  <section class="py-16 text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-4">404</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">页面不存在</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-10">这个链接可能已经失效，或从未存在过。</p>
    <div class="flex justify-center gap-6 text-sm font-medium">
      <a href="/" class="border-b-2 border-black dark:border-white pb-1">回到首页</a>
      <a href="/blog" class="text-gray-400 hover:text-black dark:hover:text-white">浏览文章</a>
    </div>
  </section>
</PageLayout>
