---
import BlogListPagination from '../../components/BlogListPagination';
import PageLayout from '../../layouts/PageLayout.astro';
import { getAllPostSummaries, getCategoryCounts, getUniqueTags, paginatePosts } from '../../utils/posts';
import { getBlogPosts } from '../../utils/content';
import { siteConfig } from '../../config/site';

const posts = await getBlogPosts();
const allPosts = getAllPostSummaries(posts);
const { posts: pagePosts, totalPages } = paginatePosts(allPosts, 1);
const uniqueTags = getUniqueTags(allPosts);
---

<PageLayout title={`文章 - ${siteConfig.name}`} description={siteConfig.description} activePath="/blog">
  <BlogListPagination
    posts={pagePosts}
    tags={uniqueTags}
    categoryCounts={getCategoryCounts(allPosts)}
    currentPage={1}
    totalPages={totalPages}
  />
</PageLayout>
