---
import BlogListPagination from '../../components/BlogListPagination';
import PageLayout from '../../layouts/PageLayout.astro';
import { getAllPostSummaries, getUniqueTags, paginatePosts } from '../../utils/posts';
import { getBlogPosts } from '../../utils/content';

const posts = await getBlogPosts();
const allPosts = getAllPostSummaries(posts);
const { posts: pagePosts, totalPages } = paginatePosts(allPosts, 1);
const uniqueTags = getUniqueTags(allPosts);
---

<PageLayout title="文章 - DESIGNER.BLOG" description="我的技术博客" activePath="/blog">
  <BlogListPagination
    client:load
    posts={pagePosts}
    tags={uniqueTags}
    currentPage={1}
    totalPages={totalPages}
  />
</PageLayout>
