---
import { getImage } from 'astro:assets';
import BlogPost from '../../components/BlogPost';
import CopyCode from '../../components/CopyCode.astro';
import ArticleImages from '../../components/ArticleImages.astro';
import PostActions from '../../components/PostActions.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TocButton from '../../components/TocButton.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { estimateReadingMinutes, getAdjacentPostSummaries, getRelatedPostSummaries } from '../../utils/posts';
import { getBlogPosts } from '../../utils/content';
import { render } from 'astro:content';
import { siteConfig } from '../../config/site';
import { englishPostSummaries } from '../../data/post-summaries-en';
import avatarSource from '../../assets/avatar.png';
export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const posts = await getBlogPosts();
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => (heading.depth === 2 || heading.depth === 3) && heading.text !== '参考文献' && heading.text !== 'Footnotes');
const { newer, older } = getAdjacentPostSummaries(posts, post);
const relatedPosts = getRelatedPostSummaries(posts, post, 3, [newer?.slug, older?.slug].filter((slug): slug is string => Boolean(slug)));
const englishTitle = englishPostSummaries[post.slug]?.title;
const readingMinutes = estimateReadingMinutes(post.body ?? '');
const avatar = await getImage({ src: avatarSource, width: 64, height: 64, format: 'webp', layout: 'fixed' });
const ogImage = post.data.ogImage ? await getImage({ src: post.data.ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80, layout: 'fixed' }) : { src: `/og/${post.slug}.png` };
---
<PageLayout title={`${post.data.title} - ${siteConfig.name}`} titleEn={englishTitle ? `${englishTitle} - Zhixian` : undefined} description={post.data.description} type="article" image={ogImage.src} publishedTime={post.data.pubDate} modifiedTime={post.data.updatedDate || post.data.pubDate} activePath="/blog">
  <div class:list={['article-grid', { 'article-grid--with-toc': tocHeadings.length > 0 }]}><div class="article-column">{tocHeadings.length > 0 && <TocButton />}<BlogPost post={post} readingMinutes={readingMinutes} relatedPosts={relatedPosts} newerPost={newer} olderPost={older} avatar={avatar.src}><Content /></BlogPost><PostActions /><CopyCode /><ArticleImages /></div>{tocHeadings.length > 0 && <TableOfContents headings={tocHeadings} />}</div>
</PageLayout>
<script>
  import { initArticleTables } from '../../scripts/article-tables';
  initArticleTables();
</script>
