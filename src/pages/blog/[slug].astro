---
import BlogPost from '../../components/BlogPost';
import PageLayout from '../../layouts/PageLayout.astro';
import { estimateReadingMinutes, getRelatedPostSummaries } from '../../utils/posts';
import { getBlogPosts } from '../../utils/content';
import { render } from 'astro:content';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedPosts = getRelatedPostSummaries(await getBlogPosts(), post);
const readingMinutes = estimateReadingMinutes(post.body ?? '');
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: siteConfig.author,
  },
};
---

<PageLayout
  title={`${post.data.title} - DESIGNER.BLOG`}
  description={post.data.description}
  type="article"
  image={post.data.heroImage}
  maxWidthClass="max-w-3xl"
  activePath="/blog"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <BlogPost client:idle post={post} readingMinutes={readingMinutes} headings={headings} relatedPosts={relatedPosts}>
    <Content />
  </BlogPost>
</PageLayout>
