---
import BlogPost from '../../components/BlogPost';
import TableOfContents from '../../components/TableOfContents';
import PageLayout from '../../layouts/PageLayout.astro';
import { estimateReadingMinutes, getRelatedPostSummaries } from '../../utils/posts';
import { getBlogPosts } from '../../utils/content';
import { render } from 'astro:content';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const relatedPosts = getRelatedPostSummaries(await getBlogPosts(), post);
const readingMinutes = estimateReadingMinutes(post.body ?? '');
const showToc = tocHeadings.length > 0;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: siteConfig.author,
  },
};
---

<PageLayout
  title={`${post.data.title} - DESIGNER.BLOG`}
  description={post.data.description}
  type="article"
  image={post.data.heroImage}
  maxWidthClass="max-w-6xl"
  activePath="/blog"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class={showToc ? 'xl:grid xl:grid-cols-[minmax(0,48rem)_14rem] xl:justify-center xl:gap-16' : 'max-w-3xl mx-auto'}>
    <div class={showToc ? 'max-w-3xl xl:max-w-none' : undefined}>
      <BlogPost client:idle post={post} readingMinutes={readingMinutes} relatedPosts={relatedPosts}>
        <Content />
      </BlogPost>
    </div>
    {showToc && (
      <aside class="hidden xl:block">
        <TableOfContents client:load headings={tocHeadings} />
      </aside>
    )}
  </div>
</PageLayout>
