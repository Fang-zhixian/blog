---
import { getImage } from 'astro:assets';
import BlogPost from '../../components/BlogPost';
import CopyCode from '../../components/CopyCode.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { estimateReadingMinutes, getAdjacentPostSummaries, getRelatedPostSummaries } from '../../utils/posts';
import { getBlogPosts } from '../../utils/content';
import { render } from 'astro:content';
import { siteConfig } from '../../config/site';
import defaultOgSource from '../../assets/avatar.png';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = await getBlogPosts();
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(
  (heading) =>
    (heading.depth === 2 || heading.depth === 3) &&
    heading.text !== '参考文献' &&
    heading.text !== 'Footnotes',
);
const relatedPosts = getRelatedPostSummaries(posts, post);
const { newer, older } = getAdjacentPostSummaries(posts, post);
const readingMinutes = estimateReadingMinutes(post.body ?? '');
const showToc = tocHeadings.length > 0;
const ogImage = await getImage({
  src: post.data.ogImage ?? defaultOgSource,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 80,
  layout: 'fixed',
});
const canonicalUrl = new URL(`/blog/${post.slug}/`, siteConfig.url).toString();
const ogImageUrl = new URL(ogImage.src, siteConfig.url).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  url: canonicalUrl,
  image: ogImageUrl,
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Person',
    name: siteConfig.author,
    url: siteConfig.url,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.author,
    url: siteConfig.url,
  },
};
---

<PageLayout
  title={`${post.data.title} - ${siteConfig.name}`}
  description={post.data.description}
  type="article"
  image={ogImage.src}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate || post.data.pubDate}
  maxWidthClass="max-w-6xl"
  activePath="/blog"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class={showToc ? 'xl:grid xl:grid-cols-[minmax(0,48rem)_14rem] xl:justify-center xl:gap-16' : 'max-w-3xl mx-auto'}>
    <div class={showToc ? 'max-w-3xl xl:max-w-none' : undefined}>
      <BlogPost
        post={post}
        readingMinutes={readingMinutes}
        relatedPosts={relatedPosts}
        newerPost={newer}
        olderPost={older}
      >
        <Content />
      </BlogPost>
      <CopyCode />
    </div>
    {showToc && <TableOfContents headings={tocHeadings} />}
  </div>
</PageLayout>
