---
import BlogListPagination from '../../../components/BlogListPagination';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getAllPostSummaries, getUniqueTags, paginatePosts, POSTS_PER_PAGE } from '../../../utils/posts';
import { getBlogPosts } from '../../../utils/content';
import { siteConfig } from '../../../config/site';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const totalPages = Math.ceil(getAllPostSummaries(posts).length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNum = index + 2;
    return {
      params: { page: String(pageNum) },
      props: { pageNum },
    };
  });
}

const { pageNum } = Astro.props;
const posts = await getBlogPosts();
const allPosts = getAllPostSummaries(posts);
const { posts: pagePosts, totalPages } = paginatePosts(allPosts, pageNum);
const uniqueTags = getUniqueTags(allPosts);
---

<PageLayout title={`文章 · 第 ${pageNum} 页 - ${siteConfig.name}`} description={siteConfig.description} activePath="/blog">
  <BlogListPagination
    client:load
    posts={pagePosts}
    tags={uniqueTags}
    currentPage={pageNum}
    totalPages={totalPages}
  />
</PageLayout>
