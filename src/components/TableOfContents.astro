---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{tocHeadings.length > 0 && (
  <>
    <nav data-toc aria-label="文章目录" class="hidden xl:block sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">目录</p>
      <ol class="border-l border-gray-200 dark:border-gray-800">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-id={heading.slug}
              class:list={[
                'block border-l-2 -ml-px py-1.5 text-sm leading-snug transition-colors border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200',
                heading.depth === 3 ? 'pl-6' : 'pl-4',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <button
      type="button"
      data-toc-open
      class="xl:hidden fixed bottom-6 right-6 z-40 flex items-center gap-2 px-4 py-3 rounded-full bg-black text-white dark:bg-white dark:text-black text-sm font-medium"
      aria-controls="mobile-toc"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="8" x2="21" y1="6" y2="6"></line>
        <line x1="8" x2="21" y1="12" y2="12"></line>
        <line x1="8" x2="21" y1="18" y2="18"></line>
        <line x1="3" x2="3.01" y1="6" y2="6"></line>
        <line x1="3" x2="3.01" y1="12" y2="12"></line>
        <line x1="3" x2="3.01" y1="18" y2="18"></line>
      </svg>
      目录
    </button>

    <dialog
      id="mobile-toc"
      data-toc-dialog
      aria-label="文章目录"
      class="xl:hidden w-full max-w-none m-0 mt-auto rounded-t-3xl bg-[#fafafa] dark:bg-[#0f0f0f] px-6 pt-5 pb-10 backdrop:bg-black/50"
    >
      <div class="flex items-center justify-between mb-4">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400">目录</p>
        <button type="button" data-toc-close aria-label="关闭目录">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <ol class="border-l border-gray-200 dark:border-gray-800">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-id={heading.slug}
              class:list={[
                'block border-l-2 -ml-px py-1.5 text-sm leading-snug transition-colors border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200',
                heading.depth === 3 ? 'pl-6' : 'pl-4',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </dialog>
  </>
)}

<script>
  function initToc() {
    const desktopNav = document.querySelector<HTMLElement>('nav[data-toc]');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[data-toc-id], dialog[data-toc-dialog] a[data-toc-id]'));
    const ids = [...new Set(links.map((link) => link.dataset.tocId).filter((id): id is string => Boolean(id)))];
    const headingElements = ids
      .map((id) => document.getElementById(id))
      .filter((element): element is HTMLElement => Boolean(element));

    const openButton = document.querySelector<HTMLButtonElement>('[data-toc-open]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-toc-close]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-toc-dialog]');

    if (openButton && dialog && !openButton.dataset.ready) {
      openButton.dataset.ready = 'true';
      openButton.addEventListener('click', () => dialog.showModal());
      closeButton?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
      dialog.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => dialog.close());
      });
    }

    if (headingElements.length === 0) {
      return;
    }

    const visible = new Map<string, boolean>();

    const setActive = (activeId: string) => {
      links.forEach((link) => {
        link.setAttribute('aria-current', link.dataset.tocId === activeId ? 'location' : 'false');
      });

      const activeLink = desktopNav?.querySelector<HTMLElement>(`[data-toc-id="${CSS.escape(activeId)}"]`);
      if (desktopNav && activeLink) {
        const navRect = desktopNav.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        if (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom) {
          desktopNav.scrollTop += linkRect.top - navRect.top - desktopNav.clientHeight / 2 + linkRect.height / 2;
        }
      }
    };

    const updateActive = () => {
      const intersecting = ids.filter((id) => visible.get(id));
      if (intersecting.length > 0) {
        setActive(intersecting[0]);
        return;
      }

      const above = headingElements.filter((element) => element.getBoundingClientRect().top < 128);
      const lastAbove = above[above.length - 1];
      if (lastAbove) {
        setActive(lastAbove.id);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible.set(entry.target.id, entry.isIntersecting);
        }
        updateActive();
      },
      {
        rootMargin: '-96px 0px -65% 0px',
        threshold: [0, 1],
      },
    );

    headingElements.forEach((element) => observer.observe(element));
    updateActive();
  }

  initToc();
</script>
