---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{tocHeadings.length > 0 && (
  <>
    <nav data-toc aria-label="文章目录" data-aria-zh="文章目录" data-aria-en="Article contents" class="hidden xl:block sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4" data-zh="目录" data-en="Contents">目录</p>
      <ol class="border-l border-gray-200 dark:border-gray-800">
        {tocHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-id={heading.slug}
              class:list={[
                'block border-l-2 -ml-px py-1.5 text-sm leading-snug transition-colors border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200',
                heading.depth === 3 ? 'pl-6' : 'pl-4',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <dialog
      id="mobile-toc"
      data-toc-dialog
      aria-label="文章目录" data-aria-zh="文章目录" data-aria-en="Article contents"
      class="xl:hidden w-full max-w-none max-h-[min(80dvh,40rem)] m-0 mt-auto flex-col overflow-hidden rounded-t-3xl bg-[#fafafa] dark:bg-[#0f0f0f] text-[#1a1a1a] dark:text-[#fafafa] p-0 backdrop:bg-black/50"
    >
      <div class="flex shrink-0 items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-800">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400" data-zh="目录" data-en="Contents">目录</p>
        <button type="button" data-toc-top class="toc-to-top" data-zh="↑ 回到顶部" data-en="↑ Back to top">↑ 回到顶部</button>
        <button type="button" data-toc-close aria-label="关闭目录" data-aria-zh="关闭目录" data-aria-en="Close contents" autofocus class="flex min-h-11 min-w-11 items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-800">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div data-toc-list class="min-h-0 overflow-y-auto overscroll-contain px-5 pt-3 pb-[max(1.25rem,env(safe-area-inset-bottom,0px))]">
        <ol class="border-l border-gray-200 dark:border-gray-800">
          {tocHeadings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-id={heading.slug}
                class:list={[
                  'flex min-h-11 items-center border-l-2 -ml-px py-3 pr-2 text-sm leading-relaxed transition-colors border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200',
                  heading.depth === 3 ? 'pl-6' : 'pl-4',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </dialog>
  </>
)}

<script>
  import { initToc } from '../scripts/toc';
  initToc();
</script>
