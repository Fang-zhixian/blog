import { siteConfig } from '../../config/site';
---
<footer class="rumo-footer">
  <div class="rumo-footer-inner">
    <a class="footer-brand" href="/">Zhixian / 方植贤</a>
    <span data-zh="记录与创造，慢慢生长。" data-en="Learning, writing, and building.">记录与创造，慢慢生长。</span>
    <span data-site-visits>访问 … 次</span><span class="metrics-status" data-metrics-status role="status" hidden></span>
    <div class="footer-links"><a href="/rss.xml" data-zh="订阅 RSS" data-en="Subscribe via RSS">订阅 RSS</a><a href={siteConfig.contacts[0].href} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/privacy" data-zh="隐私" data-en="Privacy">隐私</a></div>
    <div class="footer-mobile-actions"><button type="button" data-like-site aria-pressed="false"><span aria-hidden="true">♡</span><span data-like-label>喜欢这个小站</span><span data-like-count>…</span></button><button type="button" data-back-top-inline data-zh="↑ 回到顶部" data-en="↑ Back to top">↑ 回到顶部</button></div>
  </div>
