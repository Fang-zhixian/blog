---
import Search from '../Search.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { navItems } from '../../config/site';

interface Props {
  maxWidthClass: string;
  activePath?: string;
}

const { maxWidthClass, activePath } = Astro.props;
---

<nav id="site-nav" class="site-nav fixed top-0 w-full z-50">
  <div class={`${maxWidthClass} mx-auto px-6 flex justify-end items-center gap-2`}>
    <div class="hidden md:flex items-center space-x-8 text-sm font-medium mr-2">
      {navItems.map((item) => {
        const isActive = activePath === item.href;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-gray-800 dark:hover:text-gray-200',
              isActive ? 'text-black dark:text-white' : 'text-gray-600 dark:text-gray-300',
            ]}
          >
            {item.name}
          </a>
        );
      })}
    </div>
    <Search />
    <ThemeToggle />
    <details id="mobile-nav" class="md:hidden">
      <summary
        class="list-none cursor-pointer p-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800"
        aria-label="打开菜单"
      >
        <span class="icon-menu block">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </span>
        <span class="icon-close hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </span>
      </summary>
      <div class="fixed top-16 left-0 w-full bg-white dark:bg-black z-40 border-b border-gray-100 dark:border-gray-800">
        <div class="flex flex-col p-6 space-y-4">
          {navItems.map((item) => (
            <a href={item.href} class="text-lg font-medium text-gray-900 dark:text-gray-100">
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 20);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const mobileNav = document.getElementById('mobile-nav');
  const summary = mobileNav?.querySelector('summary');
  const syncMenuLabel = () => {
    summary?.setAttribute('aria-label', mobileNav?.open ? '关闭菜单' : '打开菜单');
  };
  mobileNav?.addEventListener('toggle', syncMenuLabel);
  syncMenuLabel();
</script>
